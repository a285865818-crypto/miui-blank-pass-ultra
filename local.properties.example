# 复制为 local.properties 后按需填写。这个文件不会入库（.gitignore 已排除）。

# Android SDK 位置（Android Studio 一般会自动写入）
# sdk.dir=/path/to/Android/Sdk

# ---- 签名（不填则构建出未签名的包，仍可 assembleDebug）----
# 路径相对 app 模块目录，不要写成 app/xxx.jks（那会解析成 app/app/xxx.jks）。
SIGN_STORE_FILE=release.jks
SIGN_STORE_PASSWORD=你的 storePassword
SIGN_KEY_ALIAS=你的 keyAlias
SIGN_KEY_PASSWORD=你的 keyPassword

# ---- 可选：期望的 APK 签名证书 SHA-256（小写 hex，无冒号，共 64 字符）----
# 填了会在两处校验：模块界面进程不一致直接结束进程；目标应用进程
# 不一致则不安装任何 hook（重打包产物因此变成空壳）。
# 留空或删掉这一行 = 不校验，方便自己编译调试。
# 取值要去掉冒号、转小写，例如：
#   keytool -list -v -keystore <你的.keystore> -alias <别名> | grep SHA256 | sed 's/.*: //;s/://g' | tr 'A-Z' 'a-z'
# （keytool 原始输出是大写 + 冒号分隔的 96 字符，直接粘贴会校验失败。）
# EXPECTED_SIG_SHA256=
