<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- miuix-blur 声明 minSdk 33；本项目 minSdk 29，
         通过 overrideLibrary 合并，低版本由 isRuntimeShaderSupported() 降级 -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:enableOnBackInvokedCallback="true"
        android:name=".App"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PermNull">

        <activity
            android:screenOrientation="portrait"
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
<!-- libxposed service 通道：LSPosed 通过该 provider 把 IXposedService binder 交给模块 -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true" />

    </application>
</manifest>
